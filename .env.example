# ─── Issatrix Agent Server ────────────────────────────────────────────────────

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Admin password for the agent console (set something strong)
ADMIN_PASSWORD=change-me-before-deploying

# JWT secret — any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Express server port (optional, defaults to 3001)
# AGENT_PORT=3001

# Allowed frontend origin for CORS (optional, defaults to http://localhost:5173)
# FRONTEND_URL=http://localhost:5173

# ─── Vite Frontend ────────────────────────────────────────────────────────────

# Backend API URL — only needed in production
# Leave empty in development (Vite proxy handles /api requests automatically)
# VITE_API_URL=https://your-api-server.example.com
